# Copie este arquivo para .env e preencha. O .env nunca vai para o GitHub.

# IA (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
# Só se a chave for de escopo Organização (sk-ant-usr-...):
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Supabase (login + banco). Valores em Project Settings > API.
# A publishable key é pública por natureza: a proteção dos dados vem do RLS do banco.
# NUNCA coloque aqui a secret/service_role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Limite de chamadas de IA por aluno por dia (proteção de custo)
# FLUENTA_DAILY_AI_LIMIT=120
